<Application x:Class="Win2FA.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#FF1F1F23"/>
        <SolidColorBrush x:Key="Bg2" Color="#FF2A2A30"/>
        <SolidColorBrush x:Key="Fg" Color="#FFF2F2F5"/>
        <SolidColorBrush x:Key="Fg2" Color="#FF9A9AA6"/>
        <SolidColorBrush x:Key="Accent" Color="#FF4C8DFF"/>
        <SolidColorBrush x:Key="Warn" Color="#FFFF6B5B"/>

        <Style TargetType="Button" x:Key="Flat">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="{StaticResource Bg2}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF3A3A44"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource Flat}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
        </Style>
        <Style TargetType="TextBox" x:Key="Field">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="{StaticResource Bg2}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="#FF3A3A44"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>
    </Application.Resources>
</Application>
