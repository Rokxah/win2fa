<Window x:Class="Win2FA.Ui.CameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win2FA · Kamerayla QR oku" Width="560" Height="520"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock Text="Kamera:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="Cameras" Width="300" HorizontalAlignment="Left" SelectionChanged="Cameras_SelectionChanged"/>
        </DockPanel>
        <Border Grid.Row="1" Background="Black" CornerRadius="8" Margin="0,10">
            <Grid>
                <Image x:Name="Preview" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform><ScaleTransform ScaleX="-1"/></Image.RenderTransform>
                </Image>
                <TextBlock x:Name="Hint" Text="Kamera açılıyor…" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Bitti" Padding="20,6" Click="Done_Click"/>
            <TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource Accent}"
                       Text="QR kodu kameraya göster."/>
        </DockPanel>
    </Grid>
</Window>
