<Window x:Class="Win2FA.Ui.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hesabı düzenle" Width="380" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border CornerRadius="14" BorderBrush="#FF34343C" BorderThickness="1" Background="#FF1E1E24" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.55"/>
        </Border.Effect>
        <StackPanel Margin="20,18,20,18">
            <TextBlock Text="Hesabı düzenle" Foreground="{StaticResource Fg}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>

            <TextBlock Text="Görünen ad (servis)" Foreground="{StaticResource Fg2}" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="IssuerBox" Style="{StaticResource Field}" FontSize="14" KeyDown="Box_KeyDown"/>

            <TextBlock Text="Hesap / açıklama" Foreground="{StaticResource Fg2}" FontSize="12" Margin="0,12,0,4"/>
            <TextBox x:Name="NameBox" Style="{StaticResource Field}" FontSize="14" KeyDown="Box_KeyDown"/>

            <TextBlock x:Name="Info" Foreground="#FF6E6E7A" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap"/>

            <DockPanel Margin="0,18,0,0" LastChildFill="False">
                <Button Style="{StaticResource Flat}" Foreground="{StaticResource Warn}" Content="Sil…" Padding="14,7" Click="Delete_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Kaydet" Padding="18,7" Click="Save_Click"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Content="Vazgeç" Padding="14,7" Margin="0,0,8,0" Click="Cancel_Click"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
